{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "tests/**/*.ts"]
}
